<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内升级：拉起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- 包可见性声明（Android 11 / API 30 起生效，鸿蒙 3.x≈11、4.x≈12 同样受此约束）。
         不加这段时 queryIntentActivities 查不到系统安装器，于是「把那批安装器
         的 content:// 读权限授出去」这一步实际什么都没授，安装器拿不到文件，
         用户看到的就是「解析软件包时出现问题」或「点了没反应」。
         Android 10 及更老系统会直接忽略这个节点，行为不变。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:label="小黑TV"
        android:supportsRtl="true"
        android:theme="@style/Theme.XiaoHeiTV"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|layoutDirection|locale|mcc|mnc|touchscreen|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|fontScale|uiMode"
            android:screenOrientation="unspecified" />

        <!-- 应用内升级：把下载好的 apk 以 content:// 交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 隐藏的线路自检页：adb shell am start -n com.xiaohei.tv/.ProbeActivity -->
        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <!-- 无界面基准测量：离屏解码计时，不改变电视画面。
             用法见 BenchReceiver 注释（adb broadcast 带 url 与 mode 两个参数） -->
        <receiver
            android:name=".bench.BenchReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.xiaohei.tv.BENCH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
