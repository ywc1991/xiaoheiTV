<?xml version="1.0" encoding="utf-8"?>
<!--
  封面底/占位：封面还没加载出来、或者图片地址失效时，这里露出一块上浅下深的暗玻璃，
  中间叠一个大号书名首字。比纯黑块好认，也不会在书架里留一个洞。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#FF15151A"
        android:startColor="#FF2C2C33"
        android:type="linear" />
    <corners android:radius="12dp" />
</shape>
