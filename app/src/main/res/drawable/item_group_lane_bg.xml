<?xml version="1.0" encoding="utf-8"?>
<!--
  分组行：焦点样式与右侧频道卡片保持一致（同一块玻璃材料）：
    焦点   → 白 24%→12% 的淡渐变 + 2dp 纯白描边，3 米外一眼锁定焦点
    选中   → 白 8% 底 + 1dp 极淡边，安静地表明右栏正在显示这一组
    其余   → 完全透明，只留文字
  半径沿用行高对应的 row_radius（行比卡片矮），其余配色与 item_channel_bg 同源。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#1FFFFFFF"
                android:startColor="#3DFFFFFF"
                android:type="linear" />
            <corners android:radius="@dimen/row_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/focus_stroke" />
        </shape>
    </item>

    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="@dimen/row_radius" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/row_radius" />
        </shape>
    </item>
</selector>
