<?xml version="1.0" encoding="utf-8"?>
<!--
  频道卡片（新玻璃样式）：
    焦点     → 白 24%→12% 的淡渐变 + 2dp 纯白描边（3 米外仍能一眼锁定焦点）
    正在播放 → 白 8% 底 + 1dp 极淡边，安静地在列表里「亮着」
    其余     → 透明，只留文字
  圆角比旧版更大（15dp → 18dp），配合外面 30dp 的面板，层级从外到内逐级变圆。
  依然不用蓝色实底：台标多是透明 PNG，蓝底会让暖色台标发脏。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#1FFFFFFF"
                android:startColor="#3DFFFFFF"
                android:type="linear" />
            <corners android:radius="@dimen/card_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/focus_stroke" />
        </shape>
    </item>

    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="@dimen/card_radius" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
</selector>
