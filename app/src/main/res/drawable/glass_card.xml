<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页那一整块玻璃卡片：和频道面板**完全同一块材料**（同一底色、同一描边），
  只把半径放大到 sheet_radius。以前这里自带一套略亮的硬编码色，
  和频道面板并排放会像两种玻璃；现在两边一起跟着 @color/glass_* 走。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_bottom"
                android:startColor="@color/glass_top"
                android:type="linear" />
            <corners android:radius="@dimen/sheet_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>

    <item
        android:height="120dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#1AFFFFFF"
                android:type="linear" />
            <corners android:radius="@dimen/sheet_radius" />
        </shape>
    </item>
</layer-list>
