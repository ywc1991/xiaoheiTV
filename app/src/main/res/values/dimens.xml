<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 列表宽度不再用 dp 写死：面板宽 = 屏宽 / 3（MainActivity 里算），
         两栏按 weight 36:64 分摊，见 activity_main.xml。 -->
    <!-- 浮层面板与屏幕边缘的距离 -->
    <dimen name="panel_margin">22dp</dimen>
    <dimen name="panel_radius">30dp</dimen>
    <!-- 卡片圆角：参考图里所有卡片都比面板更「圆」，层级越小圆角越大 -->
    <dimen name="card_radius">18dp</dimen>
    <dimen name="row_radius">14dp</dimen>
    <!-- 设置页那一整块玻璃卡片的圆角 -->
    <dimen name="sheet_radius">28dp</dimen>

    <!-- 列表项尺寸默认是「手机」值（紧凑）。电视由 values-sw500dp 覆盖回原值，
         保证手机缩小一半不会影响电视。行高 34dp 下两行文字(12sp+9sp+3dp)刚好放得下。 -->
    <dimen name="item_height">34dp</dimen>
    <dimen name="group_height">28dp</dimen>
    <dimen name="logo_size">26dp</dimen>
    <dimen name="text_channel">12sp</dimen>
    <dimen name="text_group">12sp</dimen>
    <dimen name="text_meta">9sp</dimen>
    <!-- 徽标/星标小字：电视跟着主字号一起放大 -->
    <dimen name="text_badge">10sp</dimen>

    <!-- 设置页边距：默认按手机（窄屏），sw600dp 资源里给电视放大 -->
    <dimen name="settings_pad_horizontal">20dp</dimen>
    <dimen name="settings_pad_top">24dp</dimen>
    <dimen name="settings_title">26sp</dimen>
</resources>
