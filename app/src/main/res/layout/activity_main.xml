<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- 播放区：铺满全屏，不可聚焦，避免抢走列表焦点 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- 纯音频网络电台：动态壁纸铺底，台名居中，避免一片黑屏让人以为没在播 -->
    <FrameLayout
        android:id="@+id/radioOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main"
        android:visibility="gone">

        <!-- 只在电台态绘制；切回视频台父容器立刻 GONE，视频链路一帧都不会多画 -->
        <com.xiaohei.tv.ui.RadioBackdropView
            android:id="@+id/radioBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/radioKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:shadowColor="#B3000000"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="网络电台 · 正在播放"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/radioName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#CC000000"
                android:shadowDy="3"
                android:shadowRadius="14"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                tools:text="中国之声" />

            <!-- 正在播放：只有流里真的带曲目信息才会显示（目前只有老式 ICY 流有），
                 拿不到就显示「直播中」，绝不编造内容 -->
            <TextView
                android:id="@+id/radioNowPlaying"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="620dp"
                android:shadowColor="#B3000000"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:visibility="invisible"
                tools:text="许嵩 - 多余的解释"
                tools:visibility="visible" />

            <!-- 播客专用：这一集听到哪儿了。电台是直播，没有进度，所以只在播客态显示 -->
            <LinearLayout
                android:id="@+id/podcastProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ProgressBar
                    android:id="@+id/podcastBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="320dp"
                    android:layout_height="3dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressBackgroundTint="@color/text_tertiary"
                    android:progressTint="@color/text_primary" />

                <TextView
                    android:id="@+id/podcastTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:shadowColor="#B3000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="12:31 / 45:02　← → 快退 / 快进 15 秒" />
            </LinearLayout>
        </LinearLayout>

        <!-- 字幕只属于播客播放页：贴在屏幕下方，不抢中间标题和进度条的位置。
             没有字幕轨、或两句之间空档时整个 View 隐藏，绝不留一个空框。 -->
        <TextView
            android:id="@+id/podcastSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="120dp"
            android:background="@drawable/podcast_subtitle_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:shadowColor="#CC000000"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:visibility="gone"
            tools:text="本节目由津津乐道制作播出。"
            tools:visibility="visible" />
    </FrameLayout>

    <!--
      列表展开时给画面压一层很淡的暗。
      玻璃要「浮」在画面上才好看，但电视画面常常是纯白背景或红色大字广告，
      底下太亮会把面板里的灰色小字（节目名、线路数）直接压没。
      30% 的暗只压亮度不压色彩，玻璃的通透感还在，读起来却清楚得多。
    -->
    <View
        android:id="@+id/listScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- 顶部信息：黑→透明的渐变，内容贴上沿，和画面自然融合 -->
    <LinearLayout
        android:id="@+id/infoBar"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="top"
        android:background="@drawable/info_scrim"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="32dp"
        android:paddingEnd="40dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/infoChannelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            tools:text="CCTV-1" />

        <TextView
            android:id="@+id/infoProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="正在播 新闻联播　·　接下来 焦点访谈"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/infoMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="央视 · 线路 1/5" />
    </LinearLayout>

    <!-- 播放失败提示 -->
    <TextView
        android:id="@+id/errorHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/card_overlay"
        android:gravity="center"
        android:maxWidth="420dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="正在播放…" />

    <!--
      两栏列表：一整块悬浮面板，圆角 + 发丝边，从左边浮起来。
      左＝分组（tvOS 侧边栏），右＝该分组的频道。
    -->
    <LinearLayout
        android:id="@+id/listPanel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginStart="@dimen/panel_margin"
        android:layout_marginTop="@dimen/panel_margin"
        android:layout_marginBottom="@dimen/panel_margin"
        android:background="@drawable/panel_bg"
        android:elevation="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- ============ 左栏：分组 ============ -->
            <!-- 两栏不再写死 dp：面板宽度由代码按「屏宽 1/3」算出，
                 栏宽用 weight 分摊，换台电视/换分辨率比例也不变。 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="36"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.02"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/channel_list_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/groupList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingBottom="10dp"
                    tools:listitem="@layout/item_group_lane" />
            </LinearLayout>

            <!-- 两栏之间的分隔线：一条 1dp 的发丝 -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="20dp"
                android:background="@color/divider" />

            <!-- ============ 右栏：当前分组的频道 ============ -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="64"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/laneTitle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    tools:text="央视 · 22" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/channelList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingHorizontal="8dp"
                        android:paddingBottom="12dp"
                        tools:listitem="@layout/item_channel" />

                    <ProgressBar
                        android:id="@+id/loadingBar"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/text_secondary"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 底部操作提示：只做最轻的说明，不抢视线 -->
        <TextView
            android:id="@+id/laneHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:text="↑↓ 选择　OK 播放　← 返回&#10;长按 OK 收藏　菜单 设置"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!--
      有声书书架：封面墙，盖满全屏。
      书是「先看封面挑一本，再翻章节目录」的心智，跟电视直播一路按下去完全不同，
      所以和分集面板一样单独一层，不挤在两栏列表里——右栏只有屏宽 1/3，放不下封面。
    -->
    <LinearLayout
        android:id="@+id/shelfPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="40dp"
        android:paddingEnd="56dp"
        android:paddingBottom="22dp"
        android:visibility="gone"
        tools:visibility="gone">

        <TextView
            android:id="@+id/shelfTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="有声书"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/shelfMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            tools:text="15 本 · 古典小说 · 童话寓言 · 诗词国学 · 历史故事" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shelfGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="10dp"
            tools:listitem="@layout/item_book" />

        <TextView
            android:id="@+id/shelfHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:paddingTop="8dp"
            android:text="↑↓←→ 选书　OK 打开章节目录　返回键 回分组"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!--
      播客分集面板：盖满全屏的点播列表。
      只看得到一档节目的分集，按返回回到两栏列表——播客是「先选节目、再选集」，
      和电视直播「一路按下去」的心智不一样，所以单独一层，不塞进右栏。
    -->
    <LinearLayout
        android:id="@+id/episodePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="40dp"
        android:paddingEnd="56dp"
        android:paddingBottom="22dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- 有声书才用封面：播客不占这块位置，标题直接就是面板的第一行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/episodeCover"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="封面"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/episodeShowName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    tools:text="故事FM" />

                <TextView
                    android:id="@+id/episodeShowMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    tools:text="故事 FM · 共 40 集" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episodeList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="14dp"
                tools:listitem="@layout/item_episode" />

            <ProgressBar
                android:id="@+id/episodeLoading"
                style="?android:attr/progressBarStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/text_secondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/episodeEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="这一档暂时取不到分集\n检查网络后再进来试试"
                tools:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/episodeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:paddingTop="10dp"
            android:text="↑↓ 选择　OK 播放 / 暂停　← 返回"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
