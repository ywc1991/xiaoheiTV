<?xml version="1.0" encoding="utf-8"?>
<!-- 分集卡片：标题最多两行 + 一行「日期 · 时长 · 已听」+ 右侧播放键。
     焦点样式复用频道卡片的白描边；播放键在播放中变实心，让「OK 能暂停」一眼可见。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    android:background="@drawable/item_channel_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="12dp"
    android:stateListAnimator="@animator/item_scale">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/episodeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="Vol.360 盲刺客：爱得稀里糊涂，但咱痛得明明白白啊" />

        <TextView
            android:id="@+id/episodeMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            tools:text="11-12 · 42 分钟 · 已听 18%" />
    </LinearLayout>

    <!-- 播放键：不可聚焦，焦点永远落在整行卡片上，方向键不会卡在按钮里 -->
    <FrameLayout
        android:id="@+id/episodePlayButton"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="14dp"
        android:background="@drawable/episode_play_bg"
        android:focusable="false">

        <ImageView
            android:id="@+id/episodePlayIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@string/episode_play"
            android:src="@drawable/ic_episode_play" />
    </FrameLayout>
</LinearLayout>
