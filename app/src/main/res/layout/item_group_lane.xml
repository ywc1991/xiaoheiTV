<?xml version="1.0" encoding="utf-8"?>
<!-- 分组行：只有文字，无边框无图标；焦点样式与右侧频道卡片一致（淡玻璃底 + 白描边 + 轻微放大） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/group_height"
    android:layout_marginVertical="1dp"
    android:background="@drawable/item_group_lane_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:stateListAnimator="@animator/item_scale">

    <TextView
        android:id="@+id/groupName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:maxLines="1"
        android:textColor="@color/text_group_title"
        android:textSize="@dimen/text_group"
        tools:text="央视" />

    <TextView
        android:id="@+id/groupArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        android:duplicateParentState="true"
        android:text="★"
        android:textColor="@color/text_group_meta"
        android:textSize="@dimen/text_badge"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/groupCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textColor="@color/text_group_meta"
        android:textSize="@dimen/text_meta"
        tools:text="22" />
</LinearLayout>
